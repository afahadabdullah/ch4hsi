# Optional Prism overrides: copy to slurm/site.env (git-ignored). Nothing here is required.

# Default: /panfs/ccds02/nobackup/people/$USER/ch4hsi (falls back to /explore/nobackup/people/$USER/ch4hsi)
# export CH4HSI_DATA="/panfs/ccds02/nobackup/people/$USER/ch4hsi"

# Partitions & Resources
# x86 (e.g. 2x V100, 20 cores, 380GB RAM):
# export GPU_PARTITION=gpu
# export CPU_PARTITION=compute
# export TRAIN_GPUS=2
# export TRAIN_CPUS=20
# export TRAIN_MEM=380G
# export CH4HSI_CONFIG="$CH4HSI_REPO/configs/x86_v100.yaml"

# Or GH200 Grace Hopper (aarch64):
# export GPU_PARTITION=grace
# export CPU_PARTITION=grace
# export CH4HSI_CONFIG="$CH4HSI_REPO/configs/gh200.yaml"

# Array sizes
# export DOWNLOAD_TASKS=8 DOWNLOAD_CONCURRENCY=4 PREPROCESS_TASKS=16 MDL_TASKS=4

# Slurm failure e-mails
export CH4HSI_MAIL=""

# PyTorch wheel index for the aarch64 GH200 environment
# export TORCH_INDEX=https://download.pytorch.org/whl/cu128

# Uncomment only when NCCS instructs you to use a proxy.
# export HTTPS_PROXY="" HTTP_PROXY="" NO_PROXY="localhost,127.0.0.1"
